# =============================================================================
# VERA Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Bot identity (returned by GET /v1/metadata)
# ---------------------------------------------------------------------------
TEAM_NAME=Team Vera
TEAM_MEMBERS=Your Name Here
CONTACT_EMAIL=team@example.com
BOT_VERSION=1.0.0
SUBMITTED_AT=2026-09-27T00:00:00Z

# ---------------------------------------------------------------------------
# LLM configuration
# Choose ONE provider and set its API key.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Gemini
LLM_MODEL=gemini-2.5-flash

# DeepSeek
# LLM_MODEL=deepseek-chat

# Your API key (keep secret!)
LLM_API_KEY=

# LLM timeout and token limits
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOKENS=600

# ---------------------------------------------------------------------------
# Bot behaviour
# ---------------------------------------------------------------------------
# Max actions returned per /v1/tick (challenge spec limit = 20)
MAX_ACTIONS_PER_TICK=20

# Opt-out cooldown (days). After a merchant rejects, skip all triggers for N days.
OPTOUT_COOLDOWN_DAYS=30

# Renewal triggers can override opt-out after this many days
RENEWAL_OPTOUT_OVERRIDE_DAYS=14

# Conversation turn limits
SOFT_TURN_LIMIT=5
HARD_TURN_LIMIT=7

# How long to wait after detecting auto-replies (seconds)
AUTO_REPLY_WAIT_SECONDS=86400

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
